digraph MeerupDatabaseERD {
    graph [
        label="SUPABASE DATABASE ARCHITECTURE & ENTITY-RELATIONSHIP DIAGRAM\nProject: havukdklsowjoghhtepj | PostgreSQL 15 with PostGIS Spatial Engine",
        labelloc="t",
        labeljust="c",
        fontsize=22,
        fontname="Helvetica-Bold",
        fontcolor="#F8FAFC",
        bgcolor="#0B0F19",
        rankdir="LR",
        nodesep=0.6,
        ranksep=0.9,
        dpi=300
    ];

    node [
        fontname="Helvetica",
        fontsize=10,
        shape=plain
    ];

    edge [
        fontname="Helvetica",
        fontsize=9,
        fontcolor="#94A3B8",
        color="#38BDF8",
        penwidth=1.5,
        arrowsize=0.9
    ];

    auth_users [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#1E293B">
            <tr><td colspan="3" bgcolor="#0369A1"><font color="#FFFFFF"><b>auth.users (Supabase Auth)</b></font></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">uuid</td><td align="left"><font color="#38BDF8"><b>PK</b></font></td></tr>
            <tr><td align="left">email</td><td align="left">varchar(255)</td><td align="left">unique</td></tr>
            <tr><td align="left">encrypted_password</td><td align="left">varchar(255)</td><td align="left">hash</td></tr>
            <tr><td align="left">email_confirmed_at</td><td align="left">timestamptz</td><td align="left">nullable</td></tr>
            <tr><td align="left">created_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
            <tr><td align="left">last_sign_in_at</td><td align="left">timestamptz</td><td align="left">nullable</td></tr>
        </table>
    >];

    profiles [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#1E293B">
            <tr><td colspan="3" bgcolor="#0D9488"><font color="#FFFFFF"><b>public.profiles (User Profiles)</b></font></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">uuid</td><td align="left"><font color="#38BDF8"><b>PK, FK</b></font></td></tr>
            <tr><td align="left">email</td><td align="left">text</td><td align="left">nullable</td></tr>
            <tr><td align="left">full_name</td><td align="left">text</td><td align="left">display name</td></tr>
            <tr><td align="left">avatar_url</td><td align="left">text</td><td align="left">photo link</td></tr>
            <tr><td align="left">phone</td><td align="left">text</td><td align="left">nullable</td></tr>
            <tr><td align="left">preferences</td><td align="left">jsonb</td><td align="left">language, interests</td></tr>
            <tr><td align="left">created_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
            <tr><td align="left">updated_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
        </table>
    >];

    destinations [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#1E293B">
            <tr><td colspan="3" bgcolor="#4338CA"><font color="#FFFFFF"><b>public.destinations (Landmarks &amp; Attractions)</b></font></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">uuid</td><td align="left"><font color="#38BDF8"><b>PK</b></font></td></tr>
            <tr><td align="left">name</td><td align="left">text</td><td align="left">title</td></tr>
            <tr><td align="left">description</td><td align="left">text</td><td align="left">rich summary</td></tr>
            <tr><td align="left">category</td><td align="left">text[]</td><td align="left">heritage, nature</td></tr>
            <tr><td align="left">interests</td><td align="left">text[]</td><td align="left">history, culture</td></tr>
            <tr><td align="left">district</td><td align="left">text</td><td align="left">Imphal West/Ukhrul/...</td></tr>
            <tr><td align="left">latitude</td><td align="left">float8</td><td align="left">e.g. 24.8170</td></tr>
            <tr><td align="left">longitude</td><td align="left">float8</td><td align="left">e.g. 93.9368</td></tr>
            <tr><td align="left"><font color="#34D399"><b>location</b></font></td><td align="left">geography(Point)</td><td align="left"><b>PostGIS GIST Index</b></td></tr>
            <tr><td align="left">estimated_duration_minutes</td><td align="left">int4</td><td align="left">visit time</td></tr>
            <tr><td align="left">entry_fee</td><td align="left">numeric</td><td align="left">INR ticket price</td></tr>
            <tr><td align="left">opening_time</td><td align="left">time</td><td align="left">09:00:00</td></tr>
            <tr><td align="left">closing_time</td><td align="left">time</td><td align="left">17:00:00</td></tr>
            <tr><td align="left">image_url</td><td align="left">text</td><td align="left">hero photo URL</td></tr>
            <tr><td align="left">verified</td><td align="left">bool</td><td align="left">default: true</td></tr>
            <tr><td align="left">source_url</td><td align="left">text</td><td align="left">tourism reference</td></tr>
            <tr><td align="left">created_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
        </table>
    >];

    trips [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#1E293B">
            <tr><td colspan="3" bgcolor="#B45309"><font color="#FFFFFF"><b>public.trips (Swiggy-Style Navigation Journeys)</b></font></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">uuid</td><td align="left"><font color="#38BDF8"><b>PK</b></font></td></tr>
            <tr><td align="left">user_id</td><td align="left">uuid</td><td align="left"><font color="#FBBF24"><b>FK</b></font> -&gt; auth.users</td></tr>
            <tr><td align="left">destination_id</td><td align="left">uuid</td><td align="left"><font color="#FBBF24"><b>FK</b></font> -&gt; destinations</td></tr>
            <tr><td align="left">destination_name</td><td align="left">text</td><td align="left">cached name</td></tr>
            <tr><td align="left">origin_lat</td><td align="left">float8</td><td align="left">user start lat</td></tr>
            <tr><td align="left">origin_lng</td><td align="left">float8</td><td align="left">user start lng</td></tr>
            <tr><td align="left">dest_lat</td><td align="left">float8</td><td align="left">destination lat</td></tr>
            <tr><td align="left">dest_lng</td><td align="left">float8</td><td align="left">destination lng</td></tr>
            <tr><td align="left">distance_km</td><td align="left">float8</td><td align="left">road km</td></tr>
            <tr><td align="left">estimated_duration_minutes</td><td align="left">int4</td><td align="left">ETA in minutes</td></tr>
            <tr><td align="left">status</td><td align="left">text</td><td align="left">active/completed/saved</td></tr>
            <tr><td align="left">route_summary</td><td align="left">text</td><td align="left">highway summary</td></tr>
            <tr><td align="left">polyline_geojson</td><td align="left">jsonb</td><td align="left">OSRM coordinates</td></tr>
            <tr><td align="left">created_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
            <tr><td align="left">updated_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
        </table>
    >];

    saved_places [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#1E293B">
            <tr><td colspan="3" bgcolor="#BE185D"><font color="#FFFFFF"><b>public.saved_places (User Bookmarks)</b></font></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">uuid</td><td align="left"><font color="#38BDF8"><b>PK</b></font></td></tr>
            <tr><td align="left">user_id</td><td align="left">uuid</td><td align="left"><font color="#F472B6"><b>FK</b></font> -&gt; auth.users</td></tr>
            <tr><td align="left">place_name</td><td align="left">text</td><td align="left">bookmarked title</td></tr>
            <tr><td align="left">latitude</td><td align="left">float8</td><td align="left">coord lat</td></tr>
            <tr><td align="left">longitude</td><td align="left">float8</td><td align="left">coord lng</td></tr>
            <tr><td align="left">category</td><td align="left">text</td><td align="left">tag/category</td></tr>
            <tr><td align="left">image_url</td><td align="left">text</td><td align="left">photo preview</td></tr>
            <tr><td align="left">notes</td><td align="left">text</td><td align="left">user notes</td></tr>
            <tr><td align="left">created_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
        </table>
    >];

    food [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#1E293B">
            <tr><td colspan="3" bgcolor="#047857"><font color="#FFFFFF"><b>public.food (Traditional Cuisine &amp; Eateries)</b></font></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">uuid</td><td align="left"><font color="#38BDF8"><b>PK</b></font></td></tr>
            <tr><td align="left">name</td><td align="left">text</td><td align="left">dish or restaurant</td></tr>
            <tr><td align="left">description</td><td align="left">text</td><td align="left">culinary details</td></tr>
            <tr><td align="left">category</td><td align="left">text[]</td><td align="left">thali, traditional</td></tr>
            <tr><td align="left">interests</td><td align="left">text[]</td><td align="left">foodie, authentic</td></tr>
            <tr><td align="left">district</td><td align="left">text</td><td align="left">location district</td></tr>
            <tr><td align="left">latitude</td><td align="left">float8</td><td align="left">coord lat</td></tr>
            <tr><td align="left">longitude</td><td align="left">float8</td><td align="left">coord lng</td></tr>
            <tr><td align="left">location</td><td align="left">geography(Point)</td><td align="left">PostGIS Point</td></tr>
            <tr><td align="left">image_url</td><td align="left">text</td><td align="left">photo URL</td></tr>
            <tr><td align="left">verified</td><td align="left">bool</td><td align="left">verified badge</td></tr>
            <tr><td align="left">source_url</td><td align="left">text</td><td align="left">reference</td></tr>
            <tr><td align="left">created_at</td><td align="left">timestamptz</td><td align="left">now()</td></tr>
        </table>
    >];

    rpc_nearby [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="#064E3B">
            <tr><td colspan="2" bgcolor="#059669"><font color="#FFFFFF"><b>PostGIS RPC: nearby_destinations</b></font></td></tr>
            <tr><td align="left">IN user_lat</td><td align="left">float8</td></tr>
            <tr><td align="left">IN user_lon</td><td align="left">float8</td></tr>
            <tr><td align="left">IN radius_km</td><td align="left">float8 (default: 20.0)</td></tr>
            <tr><td colspan="2" align="left"><i>Computes ST_DistanceSphere / ST_DWithin<br/>against destinations.location</i></td></tr>
        </table>
    >];

    auth_users -> profiles [label="1 : 1\n(ON DELETE CASCADE)", color="#38BDF8", penwidth=2.0];
    auth_users -> trips [label="1 : N journeys\n(ON DELETE SET NULL)", color="#FBBF24", penwidth=1.8];
    auth_users -> saved_places [label="1 : N bookmarks\n(ON DELETE CASCADE)", color="#F472B6", penwidth=1.8];
    destinations -> trips [label="1 : N targeted\n(ON DELETE SET NULL)", color="#818CF8", penwidth=1.8];
    destinations -> rpc_nearby [label="Spatial Index Scan", style="dashed", color="#34D399"];
}